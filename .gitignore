Manifest.toml

# macOS
.DS_Store

# Editor / Jupyter
.ipynb_checkpoints/

# Backup files
*.bk
*.bak

# Run logs
*.log

# Default Scythe output (old and current naming)
physical_out_*.csv
spectral_out_*.csv
*_physical.csv
*_spectral.csv
*_gridded.csv
!benchmarks/reference_data/**

# Benchmark run artifacts (committed reference data lives in benchmarks/reference_data)
benchmarks/output/
benchmarks/results/

# TC and model_tests run output (NetCDF, JLD2 restarts, ICs, ref states):
# model output never goes in the repo — validation references, when accepted,
# are committed as small JSON like the benchmarks
tc/output/
model_tests/output/
*.nc
*.jld2

reference/
